#!/usr/bin/env ruby
# Makes the live poll match deck/poll.json.
#
#   POLLS_API_TOKEN=... bin/sync-poll            # show what would change
#   POLLS_API_TOKEN=... bin/sync-poll --apply    # make the changes
#
# POLLS_API_URL defaults to https://polls.gamestats.ai
require_relative "../lib/poll_sync"

apply = ARGV.delete("--apply")
unless ARGV.empty?
  warn "Usage: bin/sync-poll [--apply]"
  exit 1
end

token = ENV["POLLS_API_TOKEN"].to_s
if token.empty?
  warn "Set POLLS_API_TOKEN to a Game Stats AI API token."
  exit 1
end

definition = JSON.parse(File.read(File.expand_path("../deck/poll.json", __dir__)))
client = PollSync::Client.new(base_url: ENV.fetch("POLLS_API_URL", "https://polls.gamestats.ai"), token: token)

begin
  PollSync.run(definition: definition, client: client, apply: !!apply)
rescue PollSync::Client::RequestFailed, SocketError, Errno::ECONNREFUSED, Net::OpenTimeout => error
  warn "Sync stopped: #{error.message}"
  exit 1
end
