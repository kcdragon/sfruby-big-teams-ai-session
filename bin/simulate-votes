#!/usr/bin/env ruby
# Simulates N people answering the question that's open right now (the one on the
# current slide), then stops.
#
#   bin/simulate-votes 30
#
# People reach for their phones over the first few seconds, tap a few seconds after
# reading, and sometimes skip or change their answer. If you move to another slide
# mid-run, answers still on their way arrive too late and the server refuses them.
#
# Real answers land on the real poll (POLLS_API_URL, default https://polls.gamestats.ai).
# Clear them afterwards with bin/poll --reset.
require "json"
require "optparse"
require_relative "../lib/vote_simulator"

options = {skip_rate: 0.1, change_rate: 0.12, seed: nil}
parser = OptionParser.new do |opts|
  opts.banner = "Usage: bin/simulate-votes N [--seed N]"
  opts.on("--seed N", Integer, "Random seed, to repeat a run") { |v| options[:seed] = v }
end
parser.parse!
count = Integer(ARGV.shift || "", exception: false)
unless count&.positive? && ARGV.empty?
  warn parser.banner
  exit 1
end

$stdout.sync = true
slug = JSON.parse(File.read(File.expand_path("../deck/poll.json", __dir__))).fetch("slug")
base_url = ENV.fetch("POLLS_API_URL", "https://polls.gamestats.ai")
seed = options[:seed] || Random.new_seed % 100_000
random = Random.new(seed)

form = VoteSimulator.parse_form(VoteSimulator::Phone.new(base_url, random).open_page(slug))
abort "No question is open right now. Go to a poll slide in the deck, then run this again." unless form
weights = VoteSimulator.popularity(form.option_ids, random)
label = form.position ? "question #{form.position}" : "the open question"
puts "#{count} people answering #{label} on #{base_url}/#{slug} (seed #{seed}). bin/poll --reset clears them afterwards.\n\n"

started = Process.clock_gettime(Process::CLOCK_MONOTONIC)
stamp = -> { format("%05.1fs", Process.clock_gettime(Process::CLOCK_MONOTONIC) - started) }
lock = Mutex.new
tally = Hash.new(0)
log = ->(message, key) { lock.synchronize { tally[key] += 1; puts "#{stamp.()}  #{message}" } }

people = Array.new(count) do |index|
  number = index + 1
  person_random = Random.new(random.rand(1 << 30))
  Thread.new do
    # Getting the phone out and the page open takes a moment, longer for some.
    sleep person_random.rand * 4
    phone = VoteSimulator::Phone.new(base_url, person_random)
    page_form = VoteSimulator.parse_form(phone.open_page(slug))
    if page_form.nil? || page_form.question_id != form.question_id
      log.("person #{number} found a different question open and stopped", :moved_on)
      next
    end
    if person_random.rand < options[:skip_rate]
      log.("person #{number} skipped it", :skipped)
      next
    end

    sleep VoteSimulator.reaction_time(person_random)
    if phone.answer(page_form, VoteSimulator.pick_options(page_form, weights, person_random)) == :too_late
      log.("person #{number} answered too late, the question had closed", :late)
      next
    end
    log.("person #{number} answered", :answered)

    if person_random.rand < options[:change_rate]
      sleep 2 + person_random.rand * 6
      changed = phone.answer(page_form, VoteSimulator.pick_options(page_form, weights, person_random))
      log.("person #{number} changed their answer", :changed) if changed == :saved
    end
  rescue VoteSimulator::Phone::Failed, SystemCallError, SocketError, Net::OpenTimeout, Net::ReadTimeout => error
    log.("person #{number} failed: #{error.message}", :failed)
  end
end

begin
  people.each(&:join)
rescue Interrupt
  people.each(&:kill)
  puts "\nStopped early."
end
puts "\nAnswered #{tally[:answered]}, changed #{tally[:changed]}, skipped #{tally[:skipped]}, too late #{tally[:late]}, " \
  "moved on #{tally[:moved_on]}, failed #{tally[:failed]}."
