#!/usr/bin/env ruby
# Rebuilds the poll slides from deck/poll.json, then makes the live poll match it.
#
#   bin/poll            # rebuild slides, show what would change on the server
#   bin/poll --apply    # rebuild slides, update the server
#   bin/poll --watch    # rebuild and update the server now and every time poll.json changes
#   bin/poll --reset    # rebuild slides, delete the poll (and every vote) and create it fresh
#   bin/poll --slides   # rebuild slides only
#
# The API token comes from POLLS_API_TOKEN. POLLS_API_URL defaults to https://polls.gamestats.ai
require "digest"
require_relative "../lib/poll_slides"
require_relative "../lib/poll_sync"

ROOT = File.expand_path("..", __dir__)
POLL_PATH = File.join(ROOT, "deck/poll.json")
MODES = %w[--apply --watch --reset --slides].freeze
$stdout.sync = true

# Rebuilds and syncs once. Returns true when everything worked.
def rebuild_and_sync(mode)
  definition = JSON.parse(File.read(POLL_PATH))
  slide_ids = PollSlides.build(
    definition: definition,
    slides_dir: File.join(ROOT, "deck/project/slides"),
    deck_path: File.join(ROOT, "deck/project/deck.json")
  )
  puts "Rebuilt #{slide_ids.size} poll slides: #{slide_ids.join(", ")}"
  return true if mode == "--slides"

  token = ENV["POLLS_API_TOKEN"].to_s
  if token.empty?
    warn "Skipped the server sync: set POLLS_API_TOKEN to the Game Stats AI polls API token."
    return false
  end

  client = PollSync::Client.new(base_url: ENV.fetch("POLLS_API_URL", "https://polls.gamestats.ai"), token: token)
  if mode == "--reset"
    PollSync.reset(definition: definition, client: client)
  else
    PollSync.run(definition: definition, client: client, apply: %w[--apply --watch].include?(mode))
  end
  true
rescue JSON::ParserError => error
  warn "deck/poll.json is not valid JSON: #{error.message.lines.first.strip}"
  false
rescue ArgumentError => error
  warn "deck/poll.json: #{error.message}"
  false
rescue PollSync::Client::RequestFailed, SocketError, SystemCallError, Net::OpenTimeout, Net::ReadTimeout => error
  warn "Sync stopped: #{error.message}"
  warn "If people have voted, question changes are refused. bin/poll --reset clears the votes and recreates the poll." if error.message.include?("422")
  false
end

# Polls the file instead of using OS file events, so it needs no gems and survives
# editors that save by replacing the file.
def watch
  puts "Watching deck/poll.json. Ctrl-C to stop."
  last_digest = nil
  loop do
    digest = File.exist?(POLL_PATH) ? Digest::SHA256.file(POLL_PATH).hexdigest : nil
    if digest && digest != last_digest
      sleep 0.3 # let a multi-step save finish
      digest = Digest::SHA256.file(POLL_PATH).hexdigest
      puts "\n[#{Time.now.strftime("%H:%M:%S")}] deck/poll.json changed" if last_digest
      rebuild_and_sync("--watch")
      last_digest = digest
    end
    sleep 0.5
  end
rescue Interrupt
  puts "\nStopped watching."
end

mode = ARGV.shift
if ARGV.any? || (mode && !MODES.include?(mode))
  warn "Usage: bin/poll [--apply | --watch | --reset | --slides]"
  exit 1
end

if mode == "--watch"
  watch
else
  exit(rebuild_and_sync(mode) ? 0 : 1)
end
